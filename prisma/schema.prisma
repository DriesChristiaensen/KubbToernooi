generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REFEREE
}

enum TournamentStatus {
  DRAFT
  LIVE
}

enum TournamentType {
  POOLS
  KNOCKOUT
  COMBINATION
}

enum MatchStatus {
  SCHEDULED
  LIVE
  AWAITING_RESULT
  PLAYED
}

enum MatchPhase {
  POOL
  KO
}

model User {
  id        String   @id @default(uuid())
  name      String
  password  String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model Tournament {
  id               String           @id @default(uuid())
  name             String           @unique
  isActive         Boolean          @default(true)
  status           TournamentStatus @default(DRAFT)
  type             TournamentType   @default(COMBINATION)
  startTime        DateTime
  matchDuration    Int              @default(15)
  breakTime        Int              @default(5)
  pointsWin        Int              @default(3)
  pointsDraw       Int              @default(1)
  pointsLoss       Int              @default(0)
  poolScheduleLive      Boolean          @default(false)
  koScheduleLive        Boolean          @default(false)
  bKoScheduleLive       Boolean          @default(false)
  hasBKnockout          Boolean          @default(false)
  qualifyGlobally       Boolean          @default(true)
  globalQualifyingTeams Int              @default(8)
  refsEnabled           Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  teams   Team[]
  fields  Field[]
  pools   Pool[]
  matches Match[]
}

model Team {
  id           String   @id @default(uuid())
  name         String
  tournamentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  poolTeams  PoolTeam[]
  matchesA   Match[]    @relation("teamA")
  matchesB   Match[]    @relation("teamB")
  koWins     Match[]    @relation("koWinner")
  standings  Standing[]

  @@unique([name, tournamentId])
}

model Field {
  id           String   @id @default(uuid())
  name         String
  tournamentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@unique([name, tournamentId])
}

model Pool {
  id             String   @id @default(uuid())
  name           String
  tournamentId   String
  teamsAdvancing Int      @default(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  poolTeams  PoolTeam[]
  matches    Match[]
  standings  Standing[]

  @@unique([name, tournamentId])
}

model PoolTeam {
  id     String @id @default(uuid())
  poolId String
  teamId String

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([poolId, teamId])
}

model Match {
  id           String      @id @default(uuid())
  phase        MatchPhase
  round        Int         @default(1)
  startTime    DateTime
  tournamentId String
  fieldId      String
  poolId       String?
  teamAId     String?
  teamBId     String?
  scoreA      Int?
  scoreB      Int?
  status      MatchStatus @default(SCHEDULED)
  koWinnerId      String?
  nextMatchId     String?
  bracketPosition Int?
  koBracket       String  @default("A")
  isByeA          Boolean @default(false)
  isByeB          Boolean @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  field       Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  pool        Pool?      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  teamA       Team?  @relation("teamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB       Team?  @relation("teamB", fields: [teamBId], references: [id], onDelete: SetNull)
  koWinner    Team?  @relation("koWinner", fields: [koWinnerId], references: [id], onDelete: SetNull)
  nextMatch   Match? @relation("MatchProgression", fields: [nextMatchId], references: [id])
  prevMatches Match[] @relation("MatchProgression")

  @@index([tournamentId])
  @@index([poolId])
  @@index([fieldId])
  @@index([startTime])
  @@index([poolId, status])
}

model RuleGroup {
  id          String   @id @default(uuid())
  orderNumber Int      @unique
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules Rule[]
}

model Rule {
  id           String    @id @default(uuid())
  orderNumber  Int
  text         String
  ruleGroupId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ruleGroup RuleGroup @relation(fields: [ruleGroupId], references: [id], onDelete: Cascade)

  @@unique([ruleGroupId, orderNumber])
}

model BeverageGroup {
  id          String     @id @default(uuid())
  orderNumber Int        @unique
  title       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  beverages Beverage[]
}

model Beverage {
  id              String        @id @default(uuid())
  orderNumber     Int
  text            String
  price           Float
  beverageGroupId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  beverageGroup BeverageGroup @relation(fields: [beverageGroupId], references: [id], onDelete: Cascade)

  @@unique([beverageGroupId, orderNumber])
}

model Standing {
  id             String   @id @default(uuid())
  poolId         String
  teamId         String
  played         Int      @default(0)
  won            Int      @default(0)
  drawn          Int      @default(0)
  lost           Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([poolId, teamId])
  @@index([poolId])
}
